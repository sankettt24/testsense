# ==============================================================================
# TestSense AI - Google ADK Agent Environment Configuration Example
# Copy this file to .env and set your actual GOOGLE_API_KEY before running.
# ==============================================================================

# 1. Google Gemini API Key (REQUIRED)
# Get your free key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="AIzaSyYourActualGoogleGeminiApiKeyHere"

# 2. Google Vertex AI Flag (0 = Google AI Studio API, 1 = Google Cloud Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=0




